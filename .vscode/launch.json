{
  "version": "0.2.0",
  "configurations": [
    {
      // Editörde açık olan .feature dosyasini calistirir (orn. THY-33.feature), tarayici gorunur
      "name": "Run current feature",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "bddgen",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${fileBasename}", "--headed"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Ayni sey, tarayici gorunmeden (daha hizli)
      "name": "Run current feature (headless)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "bddgen",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${fileBasename}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Editör gerekmez: feature adini sorar (orn. THY-33)
      "name": "Run feature by name",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "bddgen",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${input:featureName}.feature", "--headed"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Tum feature'lar, tarayici gorunur
      "name": "Run all features",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "bddgen",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "--headed"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "inputs": [
    {
      "id": "featureName",
      "type": "promptString",
      "description": "Feature adi (uzantisiz), orn. THY-33",
      "default": "THY-33"
    }
  ]
}
